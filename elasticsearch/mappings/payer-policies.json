{
  "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "chunk_text": { "type": "text", "analyzer": "english" },
      "chunk_vector": {
        "type": "dense_vector",
        "dims": 0,
        "similarity": "cosine",
        "index_options": { "type": "bbq_disk" }
      },
      "metadata": {
        "properties": {
          "chunk_id":       { "type": "keyword" },

          "policy_id":      { "type": "keyword" },
          "payer":          { "type": "keyword" },
          "title":          { "type": "keyword" },
          "version":        { "type": "keyword" },
          "supersedes":     { "type": "keyword" },
          "effective_from": { "type": "date" },
          "effective_to":   { "type": "date" },
          "applies_to_cpt": { "type": "keyword" },

          "section_no":     { "type": "keyword" },
          "section_title":  { "type": "keyword" },
          "chunk_type":     { "type": "keyword" },
          "cpt_codes_mentioned": { "type": "keyword" },
          "icd_codes_mentioned": { "type": "keyword" },
          "duration_months":{ "type": "integer" },
          "duration_days":  { "type": "integer" },
          "threshold_op":   { "type": "keyword" },
          "threshold_value":{ "type": "float" },
          "threshold_unit": { "type": "keyword" },

          "source_file":    { "type": "keyword" },
          "byte_start":     { "type": "integer" },
          "byte_end":       { "type": "integer" }
        }
      }
    }
  }
}
