# Stack version — bump together, ES and Kibana must match.
STACK_VERSION=9.2.0

# Host port Elasticsearch listens on.
ES_PORT=9200
KIBANA_PORT=5601

# JVM heap. Keep min == max. 1g is plenty for the demo dataset;
# raise to 2g if you load all 500 Synthea patients.
ES_JAVA_HEAP=1g

# Single-node dev cluster with security OFF: no TLS, no passwords, no API keys.
# This is deliberate for local hackathon work — never do this on a public network.
CLUSTER_NAME=mediaudit-x
